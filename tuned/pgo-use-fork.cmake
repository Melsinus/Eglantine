# tuned/pgo-use-cache.cmake with its tools taken from %TOOLS%, plus the CLI used to measure races.
file(TO_CMAKE_PATH "$ENV{TOOLS}" TOOLS_DIR)
set(PROFILE "${CMAKE_CURRENT_LIST_DIR}/eglantine.profdata")
set(PGO_FLAGS "-march=x86-64-v3 -mtune=generic /clang:-fprofile-use=${PROFILE} /clang:-Wno-profile-instr-unprofiled /clang:-Wno-profile-instr-out-of-date /clang:-Wno-backend-plugin")
set(CMAKE_BUILD_TYPE Release CACHE STRING "")
set(CMAKE_C_COMPILER "${TOOLS_DIR}/LLVM/bin/clang-cl.exe" CACHE FILEPATH "")
set(CMAKE_CXX_COMPILER "${TOOLS_DIR}/LLVM/bin/clang-cl.exe" CACHE FILEPATH "")
set(CMAKE_LINKER "${TOOLS_DIR}/LLVM/bin/lld-link.exe" CACHE FILEPATH "")
set(CMAKE_AR "${TOOLS_DIR}/LLVM/bin/llvm-lib.exe" CACHE FILEPATH "")
set(CMAKE_C_FLAGS "/DWIN32 /D_WINDOWS ${PGO_FLAGS}" CACHE STRING "")
set(CMAKE_CXX_FLAGS "/DWIN32 /D_WINDOWS /EHsc ${PGO_FLAGS}" CACHE STRING "")
# lldltojobs: 16 GB of RAM, keep the ThinLTO link from taking it all.
set(CMAKE_EXE_LINKER_FLAGS "/machine:x64 /opt:lldltojobs=6 ${TOOLS_DIR}/LLVM/lib/clang/23/lib/windows/clang_rt.profile-x86_64.lib" CACHE STRING "")
set(ENABLE_LTO ON CACHE BOOL "")
set(BUILD_TESTING OFF CACHE BOOL "")
set(YUZU_TESTS OFF CACHE BOOL "")
set(YUZU_CMD ON CACHE BOOL "")
set(YUZU_ROOM OFF CACHE BOOL "")
set(YUZU_ROOM_STANDALONE OFF CACHE BOOL "")
set(YUZU_USE_BUNDLED_SDL3 ON CACHE BOOL "")
set(ENABLE_UPDATE_CHECKER OFF CACHE BOOL "")
set(USE_DISCORD_PRESENCE OFF CACHE BOOL "")
set(ENABLE_WEB_SERVICE OFF CACHE BOOL "")
set(ENABLE_QT ON CACHE BOOL "")
set(ENABLE_QT_TRANSLATION OFF CACHE BOOL "")
# The bundled Qt 6.11 does not link with MSVC 14.44.
set(YUZU_USE_BUNDLED_QT OFF CACHE BOOL "")
set(CMAKE_PREFIX_PATH "${TOOLS_DIR}/Qt/6.10.2/msvc2022_64" CACHE STRING "")
set(CPM_SOURCE_CACHE "${CMAKE_CURRENT_LIST_DIR}/../.cache/cpm" CACHE PATH "")
